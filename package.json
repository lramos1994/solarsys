{
  "name": "solarsys",
  "version": "1.0.0",
  "description": "",
  "main": "index.php",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:geometry": "vitest run tests-ts/geometry",
    "test:determinism": "vitest run tests-ts/determinism",
    "test:structural": "vitest run tests-ts/structural",
    "test:browser": "playwright test e2e/browser --project=chromium --project=firefox --project=webkit",
    "test:interaction": "playwright test e2e/interaction --project=chromium",
    "test:reduced-motion": "playwright test e2e/reduced-motion --project=chromium-reduced-motion",
    "test:all": "npm run test && npm run test:browser && npm run test:interaction"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lramos1994/solarsys.git"
  },
  "author": "lucas ramos <lucas_ramos1994@hotmail.com>",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/lramos1994/solarsys/issues"
  },
  "homepage": "https://github.com/lramos1994/solarsys#readme",
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@xmldom/xmldom": "^0.9.12",
    "fast-xml-parser": "^5.11.0",
    "laravel-mix": "^6.0.49",
    "linkedom": "^0.18.13",
    "resolve-url-loader": "^5.0.0",
    "sass": "^1.57.1",
    "sass-loader": "^12.6.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
